<Window x:Class="AudioCtrl.Views.AppMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="Height"
        Width="440"
        WindowStartupLocation="CenterScreen">
    <!--
        应用风格统一弹窗（v0.14.1）：替代系统原生 MessageBox。
        深浅主题跟随（全部 DynamicResource 主题键），与深色右键菜单/Toast 同一视觉语言。
        用法：AppMessageBox.Show(owner, title, message, yesNo) → true=是/确定, false=否
    -->
    <Border CornerRadius="10"
            Background="{DynamicResource CardBackground}"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1"
            Margin="14"
            Padding="26,20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.45" />
        </Border.Effect>
        <Border.Resources>
            <!-- 弹窗按钮样式：圆角描边按钮，悬停用主题色 -->
            <Style x:Key="DialogButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Padding" Value="20,8" />
                <Setter Property="MinWidth" Value="96" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{DynamicResource CardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="7"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonHoverBackground}" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- 主按钮（是/确定）：强调色实心 -->
            <Style x:Key="DialogPrimaryButton" TargetType="Button" BasedOn="{StaticResource DialogButton}">
                <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource WindowBackground}" />
            </Style>
        </Border.Resources>
        <StackPanel>
            <TextBlock x:Name="TitleText"
                       FontSize="15"
                       FontWeight="Bold"
                       Foreground="{DynamicResource PrimaryText}"
                       Margin="0,0,0,10" />
            <TextBlock x:Name="MessageText"
                       FontSize="13"
                       TextWrapping="Wrap"
                       LineHeight="22"
                       Foreground="{DynamicResource PrimaryText}"
                       Margin="0,0,0,22" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <StackPanel.Resources>
                    <Style TargetType="Button" BasedOn="{StaticResource DialogButton}" />
                </StackPanel.Resources>
                <Button x:Name="NoButton"
                        Content="{DynamicResource S.Common.No}"
                        Style="{StaticResource DialogButton}"
                        Margin="0,0,10,0"
                        Click="OnNoClick" />
                <Button x:Name="YesButton"
                        Content="{DynamicResource S.Common.Yes}"
                        Style="{StaticResource DialogPrimaryButton}"
                        IsDefault="True"
                        Click="OnYesClick" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
