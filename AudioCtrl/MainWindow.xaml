<Window x:Class="AudioCtrl.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:helpers="clr-namespace:AudioCtrl.Helpers"
        mc:Ignorable="d"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        Title="AudioCtrl"
        Width="900" Height="650"
        MinWidth="700" MinHeight="450">

    <!--
        主窗口样式说明：
        - WindowStyle="None"：无边框窗口
        - AllowsTransparency="True"：允许透明背景
        - Background="Transparent"：透明背景，实现圆角效果
        - ResizeMode="CanResize"：支持用户拖拽拉伸
    -->

    <!-- 深色菜单样式放在 Window 层:托盘菜单(TrayIconService)与页面右键菜单共用,
         放在 Border.Resources 里时 Window.FindResource 找不到(资源只向上查找) -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <!-- 语言格式化转换器:绑定值填入语言资源串的 {0}(ConverterParameter 传资源键名) -->
        <helpers:LocFormatConverter x:Key="LocFmt" />

        <!-- 自定义右键菜单容器:深色卡片 + 圆角 + 阴影(与主题一致) -->
        <Style x:Key="DarkContextMenu" TargetType="ContextMenu">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Margin="8"
                                Background="{DynamicResource CardBackground}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="4">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.4" />
                            </Border.Effect>
                            <StackPanel IsItemsHost="True" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 自定义菜单项:无图标列,悬停高亮,有子项时右侧箭头 -->
        <Style x:Key="DarkMenuItem" TargetType="MenuItem">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid>
                            <Border x:Name="Bd"
                                    Background="Transparent"
                                    CornerRadius="5"
                                    Padding="12,7"
                                    Margin="1,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter ContentSource="Header"
                                                      RecognizesAccessKey="True"
                                                      VerticalAlignment="Center" />
                                    <!-- 子菜单箭头(仅有子项时显示) -->
                                    <Path Grid.Column="1"
                                          Data="M 0 0 L 4.5 4 L 0 8 Z"
                                          Fill="{DynamicResource SecondaryText}"
                                          Margin="14,0,0,0"
                                          VerticalAlignment="Center"
                                          Visibility="{Binding HasItems, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                            </Border>
                            <!-- 子菜单弹出层:同样式卡片 -->
                            <Popup x:Name="PART_Popup"
                                   IsOpen="{TemplateBinding IsSubmenuOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade"
                                   Placement="Right"
                                   VerticalOffset="-6"
                                   StaysOpen="True">
                                <Border Margin="10,0,10,10"
                                        Background="{DynamicResource CardBackground}"
                                        BorderBrush="{DynamicResource CardBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="4">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.35" />
                                    </Border.Effect>
                                    <StackPanel IsItemsHost="True" />
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonHoverBackground}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource SecondaryText}" />
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 深色菜单分隔线:全宽细线(默认 Separator 模板带缩进渐变,与自定义菜单不搭) -->
        <Style x:Key="DarkMenuSeparator" TargetType="Separator">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="10,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Rectangle Height="1"
                                   HorizontalAlignment="Stretch"
                                   Fill="{DynamicResource CardBorderBrush}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="12"
            Background="{DynamicResource WindowBackground}"
            MouseLeftButtonDown="OnWindowDrag"
            BorderBrush="{DynamicResource WindowBorderBrush}"
            BorderThickness="1">

        <!-- 共享设备卡片模板（播放/录制/未连接共用） -->
        <Border.Resources>
            <!-- 设备卡片样式：已连接 -->
            <Style x:Key="ConnectedCardStyle" TargetType="Border">
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Background" Value="{DynamicResource CardBackground}" />
                <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Cursor" Value="Hand" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource CardHoverBorderBrush}" />
                    </Trigger>
                    <!-- 默认设备高亮边框 -->
                    <DataTrigger Binding="{Binding IsDefault}" Value="True">
                        <Setter Property="BorderBrush" Value="#2E7D32" />
                        <Setter Property="BorderThickness" Value="2" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- 设备卡片样式：未连接（灰色半透明） -->
            <Style x:Key="DisconnectedCardStyle" TargetType="Border">
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Background" Value="{DynamicResource CardBackground}" />
                <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Opacity" Value="0.6" />
                <Setter Property="Cursor" Value="Hand" />
            </Style>

            <!-- 布尔转可见性(菜单箭头用) -->
            <!-- 映射删除小按钮 -->
            <Style x:Key="DeleteMappingButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource SecondaryText}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Padding" Value="6,2" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Content" Value="&#x2715;" />
                <Setter Property="ToolTip" Value="{DynamicResource S.Map.DeleteTip}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonHoverBackground}" />
                                    <Setter Property="Foreground" Value="#E57373" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Border.Resources>

        <Grid>
            <Grid.RowDefinitions>
                <!-- 顶部标题栏 -->
                <RowDefinition Height="40" />
                <!-- Tab 内容区 -->
                <RowDefinition Height="*" />
                <!-- 底部 HID 状态栏 -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 顶部标题栏 -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 标题 -->
                <TextBlock Grid.Column="0"
                           Text="{DynamicResource S.App.Title}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryText}"
                           Margin="16,0,0,0"
                           VerticalAlignment="Center" />

                <!-- 版本号 -->
                <TextBlock Grid.Column="1"
                           Text="{Binding AppVersion, FallbackValue='v0.1.0'}"
                           FontSize="11"
                           Foreground="{DynamicResource SecondaryText}"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center" />

                <!-- 窗口控制按钮组 -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="4,0,4,0">
                    <!-- 主题切换按钮(点击弹出深色菜单三选一,替代原生下拉框) -->
                    <Button x:Name="ThemeButton"
                            Content="{DynamicResource S.Theme.Button}"
                            FontSize="12"
                            Width="82" Height="26"
                            Margin="0,0,8,0"
                            Padding="0"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            Background="{DynamicResource ButtonBackground}"
                            Foreground="{DynamicResource ButtonForeground}"
                            Cursor="Hand"
                            Click="OnThemeButtonClick"
                            ToolTip="{DynamicResource S.Theme.Tooltip}" />
                    <!-- 语言切换按钮(弹出深色菜单三选一:跟随系统/中文/English) -->
                    <Button x:Name="LangButton"
                            Content="{DynamicResource S.Lang.Button}"
                            FontSize="12"
                            Width="96" Height="26"
                            Margin="0,0,10,0"
                            Padding="0"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            Background="{DynamicResource ButtonBackground}"
                            Foreground="{DynamicResource ButtonForeground}"
                            Cursor="Hand"
                            Click="OnLanguageButtonClick"
                            ToolTip="{DynamicResource S.Lang.Tooltip}" />
                    <!-- 最小化按钮 -->
                    <Button Content="─"
                            FontSize="14"
                            Width="36" Height="28"
                            BorderThickness="0"
                            Background="Transparent"
                            Foreground="{DynamicResource SecondaryText}"
                            Cursor="Hand"
                            Click="OnMinimizeClick"
                            ToolTip="{DynamicResource S.Btn.Minimize}" />
                    <!-- 关闭按钮 -->
                    <Button Content="×"
                            FontSize="16"
                            Width="36" Height="28"
                            BorderThickness="0"
                            Background="Transparent"
                            Foreground="{DynamicResource SecondaryText}"
                            Cursor="Hand"
                            Click="OnCloseClick"
                            ToolTip="{DynamicResource S.Btn.Close}" />
                </StackPanel>
            </Grid>

            <!-- ==================== 主内容区(单页,TabControl 外壳已移除) ==================== -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="16,8,16,8">
                <StackPanel>

                            <!-- ====== 播放设备区域 ====== -->
                            <Grid Margin="0,4,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="{DynamicResource S.Sec.Playback}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryText}"
                                           VerticalAlignment="Center" />

                                <!-- 刷新按钮 -->
                                <Button Grid.Column="2"
                                        Command="{Binding RefreshAudioDevicesCommand}"
                                        FontSize="12"
                                        Padding="12,4"
                                        BorderThickness="1"
                                        BorderBrush="{DynamicResource CardBorderBrush}"
                                        Background="{DynamicResource ButtonBackground}"
                                        Foreground="{DynamicResource ButtonForeground}"
                                        Cursor="Hand"
                                        Content="{DynamicResource S.Btn.Refresh}"
                                        HorizontalAlignment="Right" />
                            </Grid>

                            <TextBlock Text="{Binding PlaybackStatusText, FallbackValue='点击刷新按钮枚举播放设备'}"
                                       FontSize="12"
                                       Foreground="{DynamicResource SecondaryText}"
                                       Margin="0,0,0,8" />

                            <!-- 播放设备卡片 -->
                            <Grid>
                                <ItemsControl ItemsSource="{Binding ConnectedPlaybackDevices}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource ConnectedCardStyle}"
                                                    Margin="0,0,8,8"
                                                    Width="200"
                                                    Tag="{Binding}"
                                                    MouseLeftButtonUp="OnAudioDeviceCardClick"
                                                    ContextMenuOpening="OnDeviceCardContextMenuOpening">
                                                <!-- XAML 里先挂好菜单壳(空壳+样式),保证第一次右键就能弹出;
                                                     菜单项在 ContextMenuOpening 事件里动态填充 -->
                                                <Border.ContextMenu>
                                                    <ContextMenu Style="{StaticResource DarkContextMenu}" />
                                                </Border.ContextMenu>
                                                <StackPanel Margin="12">
                                                    <!-- 设备图标 + 类型标签 + 默认标记 -->
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <!-- 设备类型图标（▶ 播放） -->
                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding IconSymbol}"
                                                                   FontSize="16"
                                                                   Foreground="{DynamicResource PrimaryText}"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,8,0" />

                                                        <!-- 设备类型标签 -->
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding TypeLabel}"
                                                                   FontSize="10"
                                                                   Foreground="{DynamicResource SecondaryText}"
                                                                   VerticalAlignment="Center" />

                                                        <!-- 默认设备勾选标记 -->
                                                        <TextBlock Grid.Column="2"
                                                                   FontSize="14"
                                                                   FontWeight="Bold"
                                                                   VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                                                            <Setter Property="Text" Value="&#x2714;" />
                                                                            <Setter Property="Foreground" Value="#2E7D32" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsDefault}" Value="False">
                                                                            <Setter Property="Text" Value="" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>

                                                    <!-- 设备名称 -->
                                                    <TextBlock Text="{Binding Name}"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource PrimaryText}"
                                                               Margin="0,6,0,4"
                                                               TextTrimming="CharacterEllipsis"
                                                               TextWrapping="NoWrap" />

                                                    <!-- 设备连接状态 -->
                                                    <TextBlock Text="{DynamicResource S.Dev.Connected}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource SecondaryText}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- 空列表提示 -->
                                <TextBlock Text="{DynamicResource S.Dev.PlaybackEmpty}"
                                           FontSize="13"
                                           Foreground="{DynamicResource SecondaryText}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Margin="0,16">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ConnectedPlaybackDevices.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <!-- 分隔线 -->
                            <Border Height="1" Margin="0,4,0,12" Background="{DynamicResource CardBorderBrush}" />

                            <!-- ====== 录制设备区域 ====== -->
                            <TextBlock Text="{DynamicResource S.Sec.Recording}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryText}"
                                       Margin="0,4,0,2" />

                            <TextBlock Text="{Binding RecordingStatusText, FallbackValue='点击刷新按钮枚举录制设备'}"
                                       FontSize="12"
                                       Foreground="{DynamicResource SecondaryText}"
                                       Margin="0,0,0,8" />

                            <!-- 录制设备卡片 -->
                            <Grid>
                                <ItemsControl ItemsSource="{Binding ConnectedRecordingDevices}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource ConnectedCardStyle}"
                                                    Margin="0,0,8,8"
                                                    Width="200"
                                                    Tag="{Binding}"
                                                    MouseLeftButtonUp="OnAudioDeviceCardClick"
                                                    ContextMenuOpening="OnDeviceCardContextMenuOpening">
                                                <!-- XAML 里先挂好菜单壳(空壳+样式),保证第一次右键就能弹出;
                                                     菜单项在 ContextMenuOpening 事件里动态填充 -->
                                                <Border.ContextMenu>
                                                    <ContextMenu Style="{StaticResource DarkContextMenu}" />
                                                </Border.ContextMenu>
                                                <StackPanel Margin="12">
                                                    <!-- 设备图标 + 类型标签 + 默认标记 -->
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <!-- 设备类型图标（● 录制） -->
                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding IconSymbol}"
                                                                   FontSize="16"
                                                                   Foreground="{DynamicResource PrimaryText}"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,8,0" />

                                                        <!-- 设备类型标签 -->
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding TypeLabel}"
                                                                   FontSize="10"
                                                                   Foreground="{DynamicResource SecondaryText}"
                                                                   VerticalAlignment="Center" />

                                                        <!-- 默认设备勾选标记 -->
                                                        <TextBlock Grid.Column="2"
                                                                   FontSize="14"
                                                                   FontWeight="Bold"
                                                                   VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                                                            <Setter Property="Text" Value="&#x2714;" />
                                                                            <Setter Property="Foreground" Value="#2E7D32" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsDefault}" Value="False">
                                                                            <Setter Property="Text" Value="" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>

                                                    <!-- 设备名称 -->
                                                    <TextBlock Text="{Binding Name}"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource PrimaryText}"
                                                               Margin="0,6,0,4"
                                                               TextTrimming="CharacterEllipsis"
                                                               TextWrapping="NoWrap" />

                                                    <!-- 设备连接状态 -->
                                                    <TextBlock Text="{DynamicResource S.Dev.Connected}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource SecondaryText}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- 空列表提示 -->
                                <TextBlock Text="{DynamicResource S.Dev.RecordingEmpty}"
                                           FontSize="13"
                                           Foreground="{DynamicResource SecondaryText}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Margin="0,16">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ConnectedRecordingDevices.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <!-- ====== 耳机支架状态区(协议 v2) ====== -->
                            <Grid Margin="0,12,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{DynamicResource S.Sec.Stand}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryText}"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="{DynamicResource S.Stand.Hint}"
                                           FontSize="11"
                                           Foreground="{DynamicResource SecondaryText}"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right" />
                            </Grid>

                            <!-- 支架列表 -->
                            <ItemsControl ItemsSource="{Binding Stands}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource CardBackground}"
                                                BorderBrush="{DynamicResource CardBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Margin="0,0,0,6"
                                                Padding="12,8">
                                            <StackPanel Orientation="Horizontal">
                                                <!-- 在线状态圆点:绿=在线,灰=离线 -->
                                                <Ellipse Width="10" Height="10" VerticalAlignment="Center">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="#9E9E9E" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Online}" Value="True">
                                                                    <Setter Property="Fill" Value="#4CAF50" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>

                                                <!-- 支架 ID -->
                                                <TextBlock Text="{Binding StandIdHex, Converter={StaticResource LocFmt}, ConverterParameter=S.Stand.IdFmt}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource PrimaryText}"
                                                           VerticalAlignment="Center"
                                                           Margin="10,0,0,0" />

                                                <!-- 拿起状态 -->
                                                <TextBlock FontSize="12"
                                                           Margin="16,0,0,0"
                                                           VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}" />
                                                            <Setter Property="Text" Value="{DynamicResource S.Stand.OnStand}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Lifted}" Value="True">
                                                                    <Setter Property="Text" Value="{DynamicResource S.Stand.Lifted}" />
                                                                    <Setter Property="Foreground" Value="#2E7D32" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <!-- 最近事件时间 -->
                                                <TextBlock Text="{Binding LastEventText, Converter={StaticResource LocFmt}, ConverterParameter=S.Stand.LastEventFmt}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource SecondaryText}"
                                                           VerticalAlignment="Center"
                                                           Margin="16,0,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- 无支架提示(有支架时隐藏) -->
                            <TextBlock Text="{DynamicResource S.Stand.None}"
                                       FontSize="12"
                                       Foreground="{DynamicResource SecondaryText}"
                                       Margin="0,4,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Stands.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- ====== 映射配置区(显示右键配置的结果,可删除) ====== -->
                            <Grid Margin="0,14,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{DynamicResource S.Sec.Mapping}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryText}"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="{DynamicResource S.Map.Hint}"
                                           FontSize="11"
                                           Foreground="{DynamicResource SecondaryText}"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right" />
                            </Grid>

                            <ItemsControl ItemsSource="{Binding Mappings}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource CardBackground}"
                                                BorderBrush="{DynamicResource CardBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Margin="0,0,0,6"
                                                Padding="12,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- 图标 -->
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding Icon}"
                                                           FontSize="14"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,10,0" />

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource PrimaryText}" />
                                                    <TextBlock Text="{Binding Detail}"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource SecondaryText}"
                                                               Margin="0,2,0,0"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>

                                                <!-- 删除按钮 -->
                                                <Button Grid.Column="2"
                                                        Style="{StaticResource DeleteMappingButton}"
                                                        Tag="{Binding Tag}"
                                                        Click="OnDeleteMappingClick"
                                                        VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- 无映射提示 -->
                            <TextBlock Text="{DynamicResource S.Map.None}"
                                       FontSize="12"
                                       Foreground="{DynamicResource SecondaryText}"
                                       Margin="0,4,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Mappings.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- ====== 未连接设备折叠区域 ====== -->
                            <Border Margin="0,8,0,0"
                                    Background="{DynamicResource CardBackground}"
                                    BorderBrush="{DynamicResource CardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <StackPanel>
                                    <!-- 折叠/展开按钮 -->
                                    <Button Command="{Binding ToggleDisconnectedCommand}"
                                            BorderThickness="0"
                                            Background="Transparent"
                                            Foreground="{DynamicResource SecondaryText}"
                                            Cursor="Hand"
                                            HorizontalContentAlignment="Left"
                                            Padding="12,8">
                                        <Button.Content>
                                            <StackPanel Orientation="Horizontal">
                                                <!-- 箭头方向随展开状态变化 -->
                                                <TextBlock FontSize="12" Margin="0,0,8,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ShowDisconnected}" Value="True">
                                                                    <Setter Property="Text" Value="▼" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding ShowDisconnected}" Value="False">
                                                                    <Setter Property="Text" Value="▶" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock FontSize="13">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ShowDisconnected}" Value="True">
                                                                    <Setter Property="Text" Value="{DynamicResource S.Dev.Hide}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding ShowDisconnected}" Value="False">
                                                                    <Setter Property="Text" Value="{DynamicResource S.Dev.Show}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding DisconnectedDevices.Count, Converter={StaticResource LocFmt}, ConverterParameter=S.Dev.CountFmt}"
                                                           FontSize="12"
                                                           Margin="6,0,0,0"
                                                           Foreground="{DynamicResource SecondaryText}" />
                                            </StackPanel>
                                        </Button.Content>
                                    </Button>

                                    <!-- 展开后的未连接设备卡片 -->
                                    <ItemsControl ItemsSource="{Binding DisconnectedDevices}"
                                                  Margin="0,0,0,4">
                                        <ItemsControl.Style>
                                            <Style TargetType="ItemsControl">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ShowDisconnected}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ItemsControl.Style>

                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" Margin="12,0,12,8" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>

                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <!-- 未连接卡片不绑点击:对非活跃端点设默认会被 Windows 静默拒绝 -->
                                                <Border Style="{StaticResource DisconnectedCardStyle}"
                                                        Margin="0,0,8,8"
                                                        Width="200"
                                                        Tag="{Binding}">
                                                    <StackPanel Margin="12">
                                                        <!-- 设备图标 + 类型标签 -->
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>

                                                            <!-- 设备类型图标 -->
                                                            <TextBlock Grid.Column="0"
                                                                       Text="{Binding IconSymbol}"
                                                                       FontSize="16"
                                                                       Foreground="{DynamicResource SecondaryText}"
                                                                       VerticalAlignment="Center"
                                                                       Margin="0,0,8,0" />

                                                            <!-- 设备类型标签 -->
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding TypeLabel}"
                                                                       FontSize="10"
                                                                       Foreground="{DynamicResource SecondaryText}"
                                                                       VerticalAlignment="Center" />
                                                        </Grid>

                                                        <!-- 设备名称（灰色） -->
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontSize="13"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource SecondaryText}"
                                                                   Margin="0,6,0,4"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   TextWrapping="NoWrap" />

                                                        <!-- 未连接状态 -->
                                                        <TextBlock Text="{DynamicResource S.Dev.Disconnected}"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource SecondaryText}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- 总体状态文本 -->
                            <TextBlock Text="{Binding AudioStatusText}"
                                       FontSize="11"
                                       Foreground="{DynamicResource SecondaryText}"
                                       Margin="0,8,0,4"
                                       TextAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AudioStatusText}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                </StackPanel>
            </ScrollViewer>

            <!-- ==================== 底部 HID 状态栏 ==================== -->
            <Border Grid.Row="2"
                    Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="12,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- HID 连接状态 -->
                    <TextBlock Grid.Column="0"
                               Text="{Binding HidStatusText, FallbackValue='正在检测支架...'}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryText}"
                               VerticalAlignment="Center" />

                    <!-- 已检测到的 HID 设备数量 -->
                    <TextBlock Grid.Column="1"
                               Text="{Binding HidDeviceCount}"
                               FontSize="11"
                               Foreground="{DynamicResource SecondaryText}"
                               Margin="16,0,0,0"
                               VerticalAlignment="Center" />

                    <!-- HID 接收历史记录（最近 3 条，横向排列） -->
                    <TextBlock Grid.Column="2"
                               Text="{Binding HidHistoryText, FallbackValue='等待支架事件...'}"
                               FontSize="11"
                               Foreground="{DynamicResource SecondaryText}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
