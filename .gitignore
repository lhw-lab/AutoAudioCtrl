# ===== 上位机 AudioCtrl =====
# .NET 构建产物
AudioCtrl/bin/
AudioCtrl/obj/
AudioCtrl/*.user
AudioCtrl/.vs/
AudioCtrl/.idea/
AudioCtrl/.vscode/

# 运行期生成（便携模式，日志与配置不入库）
AudioCtrl/**/Logs/
AudioCtrl/**/Config/
AudioCtrl/publish/
AudioCtrl/dist/

# ===== 固件 firmware =====
stm32/firmware/Debug/
stm32/firmware/Release/
stm32/firmware/*.map
stm32/firmware/*.lst
stm32/firmware/*.o
stm32/firmware/*.elf
stm32/firmware/*.bin
stm32/firmware/*.hex
stm32/firmware/*.su
stm32/firmware/*.launch
*.cproject.bak
*.project.bak

# ===== 固件 firmware-c3 (PlatformIO 构建产物不入库) =====
firmware-c3/.pio/
firmware-c3/**/__pycache__/

# ===== 测试项目 tests =====
tests/**/bin/
tests/**/obj/
tests/**/TestResults/
*.trx

# ===== 通用 =====
Thumbs.db
Desktop.ini
.DS_Store

# ===== 发布产物（pack-release.ps1 输出，不入库） =====
AudioCtrl-portable-*.zip
